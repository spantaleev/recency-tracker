{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"helpers:pinGitHubActionDigests"
	],
	"labels": ["dependencies"],
	"rangeStrategy": "pin",
	"prConcurrentLimit": 3,
	"rebaseWhen": "behind-base-branch",
	"automerge": false,
	"lockFileMaintenance": {
		"enabled": true
	}
}
